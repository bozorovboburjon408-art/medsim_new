# AI provayderi: gemini yoki claude (keyinroq almashtirish mumkin)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_EVAL_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# TTS: edge (sinov uchun) yoki azure
TTS_PROVIDER=edge
# Google Cloud Text-to-Speech kaliti (faqat ovoz laboratoriyasi uchun, $300 kredit)
GOOGLE_TTS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Vertex AI ($300 Cloud krediti): service account JSON matni (bir qatorda yoki ko'p qatorda). Bo'sh bo'lsa AI Studio kaliti ishlatiladi
GOOGLE_SA_JSON=
VERTEX_LOCATION=global
VERTEX_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash
VERTEX_EVAL_MODELS=gemini-2.5-flash,gemini-2.5-pro
